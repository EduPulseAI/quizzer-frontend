generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  expires_at        Int?
  createdat         DateTime? @db.Timestamp(6)
  updatedat         DateTime? @db.Timestamp(6)
  userId            String?   @db.Uuid
  access_token      String?   @db.VarChar(255)
  id_token          String?   @db.VarChar(255)
  provider          String    @db.VarChar(255)
  providerAccountId String    @db.VarChar(255)
  refresh_token     String?   @db.VarChar(255)
  scope             String?   @db.VarChar(255)
  session_state     String?   @db.VarChar(255)
  token_type        String?   @db.VarChar(255)
  users             users?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkkhd68ixy8n5b3kt3vp4r4wt50")

  @@id([provider, providerAccountId])
}

model roles {
  id          BigInt       @id @default(autoincrement())
  name        String       @db.VarChar(50)
  description String?      @db.VarChar(255)
  users_roles users_roles?
}

model sessions {
  expires      DateTime? @db.Timestamp(6)
  userId       String?   @db.Uuid
  id           String    @id @db.VarChar(255)
  sessionToken String?   @unique @db.VarChar(255)
  users        users?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6ii26lpwbni9yt8spnl0tftne")
}

model users {
  created_at    DateTime      @db.Timestamptz(6)
  emailVerified DateTime?     @db.Timestamptz(6)
  updated_at    DateTime      @db.Timestamptz(6)
  id            String        @id @db.Uuid
  email         String        @unique @db.VarChar(255)
  image         String?       @db.VarChar(255)
  name          String?       @db.VarChar(255)
  pwd_hash      String        @db.VarChar(255)
  accounts      accounts[]
  sessions      sessions[]
  users_roles   users_roles[]
}

model users_roles {
  roles_id BigInt @unique
  user_id  String @db.Uuid
  roles    roles  @relation(fields: [roles_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fka62j07k5mhgifpp955h37ponj")
  users    users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fke6k7h92pkxjim6t1176b7h95x")

  @@id([roles_id, user_id])
}

model verification_tokens {
  expires    DateTime @db.Timestamptz(6)
  issued_at  DateTime @db.Timestamptz(6)
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)

  @@id([identifier, token])
}
